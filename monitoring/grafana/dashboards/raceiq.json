  {
   "type": "stat",
   "title": "LLM fallback rate",
   "id": 16,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "description": "Share of LLM-backed requests served the template. Alert above 20%.",
   "gridPos": {
    "h": 8,
    "w": 6,
    "x": 0,
    "y": 35
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum(rate(raceiq_engineer_requests_total{outcome=~\"template_validation|template_provider_error\"}[15m])) / sum(rate(raceiq_engineer_requests_total{outcome=~\"llm_first_try|llm_after_retry|template_validation|template_provider_error\"}[15m]))",
     "legendFormat": "fallback share",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.1
       },
       {
        "color": "red",
        "value": 0.2
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "type": "stat",
   "title": "Violations per LLM request",
   "id": 17,
   "datasource": {
    "type": "prometheus",
