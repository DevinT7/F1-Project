{
 "title": "RaceIQ",
 "uid": "raceiq-overview",
 "schemaVersion": 41,
 "version": 1,
 "editable": true,
 "tags": [
  "raceiq"
 ],
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "refresh": "30s",
 "timezone": "utc",
 "description": "RaceIQ service health: API, cache, jobs, LLM engineer, model drift. Alerts: monitoring/prometheus/alerts.yml.",
 "templating": {
  "list": [
   {
    "name": "datasource",
    "label": "Prometheus",
    "type": "datasource",
    "query": "prometheus",
    "current": {},
    "hide": 0,
    "refresh": 1
   }
  ]
 },
 "annotations": {
  "list": []
 },
 "panels": [
  {
   "type": "row",
   "title": "API",
   "id": 1,
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   }
  },
  {
   "type": "stat",
   "title": "5xx error rate",
   "id": 2,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "description": "Alert RaceIQHighErrorRate above 1% for 10 min.",
   "gridPos": {
    "h": 8,
    "w": 6,
    "x": 0,
    "y": 1
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum(rate(raceiq_http_requests_total{status=~\"5..\"}[5m])) / sum(rate(raceiq_http_requests_total[5m]))",
     "legendFormat": "5xx share",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.005
       },
       {
        "color": "red",
        "value": 0.01
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "type": "stat",
   "title": "Cached comparison p95",
   "id": 3,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "description": "Target < 500 ms (load test: loadtests/README.md).",
   "gridPos": {
    "h": 8,
    "w": 6,
    "x": 6,
    "y": 1
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "histogram_quantile(0.95, sum by (le) (rate(raceiq_http_request_duration_seconds_bucket{route=\"/api/v1/comparisons\"}[5m])))",
     "legendFormat": "p95",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.3
       },
       {
        "color": "red",
        "value": 0.5
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "type": "stat",
   "title": "Cache hit ratio",
   "id": 4,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "description": "",
   "gridPos": {
    "h": 8,
    "w": 6,
    "x": 12,
    "y": 1
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum(rate(raceiq_cache_lookups_total{result=\"hit\"}[15m])) / sum(rate(raceiq_cache_lookups_total[15m]))",
     "legendFormat": "hit ratio",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.5
       },
       {
        "color": "green",
        "value": 0.8
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     },
     "min": 0,
     "max": 1
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "type": "stat",
   "title": "Requests / s",
   "id": 5,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "description": "",
   "gridPos": {
    "h": 8,
    "w": 6,
    "x": 18,
    "y": 1
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum(rate(raceiq_http_requests_total[5m]))",
     "legendFormat": "req/s",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Requests by status class",
   "id": 6,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "description": "",
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 9
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum by (class) (label_replace(rate(raceiq_http_requests_total[5m]), \"class\", \"${1}xx\", \"status\", \"(.)..\"))",
     "legendFormat": "{{class}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Latency (all routes)",
   "id": 7,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "description": "",
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 8,
    "y": 9
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "histogram_quantile(0.5, sum by (le) (rate(raceiq_http_request_duration_seconds_bucket[5m])))",
     "legendFormat": "p50",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "histogram_quantile(0.95, sum by (le) (rate(raceiq_http_request_duration_seconds_bucket[5m])))",
     "legendFormat": "p95",
     "refId": "B"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "histogram_quantile(0.99, sum by (le) (rate(raceiq_http_request_duration_seconds_bucket[5m])))",
     "legendFormat": "p99",
     "refId": "C"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "type": "timeseries",
