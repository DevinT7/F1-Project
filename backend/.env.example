# Copy to .env and fill in as needed. All optional for historical (free) data.
# Which phase needs which API key: docs/api_keys.md.

# OpenF1 live/sponsor tier only (historical is free, no key needed)
# RACEIQ_OPENF1_API_KEY=

# FastF1 on-disk cache dir
RACEIQ_FASTF1_CACHE_DIR=.fastf1_cache
RACEIQ_ENABLE_FASTF1=true

# App cache
RACEIQ_CACHE_TTL_SECONDS=3600
# RACEIQ_REDIS_URL=redis://localhost:6379/0

# Tire model (optional — baseline fallback works without this)
# Defaults to ../ml/models/tire_model.pkl, which is gitignored.
# RACEIQ_TIRE_MODEL_PATH=
# Serve the model even when its artifact records beats_baseline=False.
# The shipped artifact does (see ml/models/MODEL_CARD.md), so this is the only way
# to exercise the model path today.
# RACEIQ_TIRE_MODEL_FORCE=false

# AI race engineer (optional — template fallback works without this)
# RACEIQ_OPENAI_API_KEY=
RACEIQ_AI_MODEL=gpt-4o-mini

# LLM for Phase 7 reports (7D) and follow-up Q&A (7E) — optional for running the app
# (templates are served without it), REQUIRED for the 7D/7E live evaluation gates.
# PLACEHOLDER — API KEY NEEDED: fill in these three, then run the live evals (docs/api_keys.md).
# LLM_PROVIDER: anthropic | openai  (openai also covers OpenAI-compatible endpoints such as
# Groq, OpenRouter or a local Ollama; set LLM_BASE_URL for those)
# LLM_PROVIDER=
# LLM_MODEL=
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_TIMEOUT_S=60
# Optional, only for the eval scripts' cost estimate ($ per million tokens):
# LLM_PRICE_IN_PER_MTOK=
# LLM_PRICE_OUT_PER_MTOK=
# DEBUG only: log the prompt (FactSheet) at DEBUG level. Never in production.
# RACEIQ_AI_DEBUG_LOG_FACTSHEET=1

# CORS (frontend dev servers)
RACEIQ_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
